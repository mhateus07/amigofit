{
  "expo": {
    "name": "AmigoFit",
    "slug": "amigofit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00C853",
          "sounds": []
        }
      ],
      [
        "react-native-health-connect",
        {
          "androidHealthConnectPermissions": [
            "android.permission.health.READ_SLEEP",
            "android.permission.health.READ_STEPS",
            "android.permission.health.READ_EXERCISE",
            "android.permission.health.READ_HEART_RATE",
            "android.permission.health.READ_WEIGHT"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Permite importar sono, passos, treinos, peso e frequência cardíaca do Apple Saúde para o Diário e Insights, sem precisar digitar nada.",
          "NSHealthUpdateUsageDescription": "Permite importar sono, passos, treinos, peso e frequência cardíaca do Apple Saúde para o Diário e Insights, sem precisar digitar nada."
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Permite gravar sua voz para transcrever e registrar no chat, sem precisar digitar."
        }
      ],
      "expo-video",
      "expo-font",
      "./plugins/withIosMinDeploymentTargetFix.js",
      "./plugins/withIosSceneLifecycle.js",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-bg.png",
          "resizeMode": "cover",
          "backgroundColor": "#0F0F0F"
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Permite enviar fotos e prints para o AmigoFit analisar.",
        "NSCameraUsageDescription": "Permite gravar vídeos de execução dos exercícios para anexar nas fichas de treino.",
        "NSLocalNetworkUsageDescription": "Permite conectar ao servidor de desenvolvimento (Metro) durante testes no aparelho.",
        "NSBonjourServices": [
          "_dev._tcp",
          "_http._tcp"
        ]
      },
      "bundleIdentifier": "com.mhateus07.amigofit",
      "appleTeamId": "FLYUDYHKDQ"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.amigofit"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "057aa24d-b1ca-4dc7-9996-dc1938c5cf06"
      }
    },
    "owner": "mhateus07"
  }
}
