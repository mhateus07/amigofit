DB_PASSWORD=troque_esta_senha
JWT_SECRET=gere_um_segredo_aleatorio_forte_aqui
# Chave mestra que criptografa as chaves de IA dos usuários no banco (mín. 32
# caracteres). Gere com: openssl rand -base64 48 — e guarde uma cópia fora da
# VPS: sem ela, as chaves salvas ficam ilegíveis e os usuários precisam
# cadastrá-las de novo.
AI_KEYS_SECRET=gere_com_openssl_rand_base64_48
# Opcional: destino rclone para cópia externa dos backups (ex.: b2:amigofit-backups)
BACKUP_REMOTE=
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
EXPO_PUBLIC_API_BASE_URL=https://amigofit-api.impulsiodigital.com
